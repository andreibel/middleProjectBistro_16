<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="632.0" prefWidth="608.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.BistroClientGUIController">
   <children>
      <TableView fx:id="tableViewOrders" prefHeight="569.0" prefWidth="590.0">
         <columns>
            <TableColumn fx:id="orderNumberColumn" prefWidth="89.5" text="Order Number" />
            <TableColumn fx:id="orderDateTimeColumn" prefWidth="69.5" text="Order Date" />
            <TableColumn fx:id="numberOfGuestsColumn" prefWidth="76.0" text="# of Guests" />
            <TableColumn fx:id="conformationCodeColumn" prefWidth="117.0" text="Confirmation Code" />
            <TableColumn fx:id="subscriberIdColumn" prefWidth="95.0" text="Subscriber ID" />
            <TableColumn fx:id="placedOrderDateTimeColumn" prefWidth="136.0" text="Date of Placing Order" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
         <children>
            <Label fx:id="lblOrderDate" prefHeight="17.0" prefWidth="82.0" text="Order's Date:" />
            <DatePicker fx:id="orderDatePicker" nodeOrientation="LEFT_TO_RIGHT" prefHeight="26.0" prefWidth="131.0">
               <padding>
                  <Insets left="10.0" />
               </padding>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </DatePicker>
            <Label fx:id="lblNumberOfGuests" prefHeight="17.0" prefWidth="106.0" text="Number Of Guests:" />
            <TextField fx:id="txtBoxNumberOfGuests" alignment="CENTER" prefHeight="26.0" prefWidth="115.0" />
            <Button fx:id="btnUpdateOrder" mnemonicParsing="false" text="Update Order" />
         </children>
         <padding>
            <Insets left="10.0" top="20.0" />
         </padding>
      </HBox>
   </children>
</VBox>
