<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<AnchorPane prefHeight="600.0" prefWidth="1060.0" stylesheets="@../../../../style/style.css"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.andreibel.client.Subscriber.SubscriberLoginFormGUIController">

    <children>
        <!-- Full page container -->
        <VBox alignment="TOP_CENTER" spacing="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox prefHeight="70.0" prefWidth="1556.0" spacing="20.0" style="-fx-min-width: 1040; -fx-max-width: 1040;">
                <children>
                    <!-- Top bar (also uses .card, so must override width too) -->
                    <HBox alignment="CENTER_RIGHT" fillHeight="false" maxWidth="1000.0" minHeight="-Infinity"
                          minWidth="1000.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="70.0" prefWidth="1000.0"
                          style="-fx-min-width: 940; -fx-pref-width: 940; -fx-max-width: 940;" styleClass="card">
                        <children>
                            <Label fx:id="lblTitle" styleClass="title" text="Subscriber Login"
                                   wrapText="true"/>
                            <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../../img/logo.png"/>
                                </image>
                                <viewport>
                                    <Rectangle2D minX="1.0"/>
                                </viewport>
                            </ImageView>
                        </children>
                    </HBox>
                    <Pane prefHeight="70.0" prefWidth="70.0" styleClass="card">
                        <children>

                            <!-- Back button moved here -->
                            <Button fx:id="btnGoBack" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false"
                                    onAction="#onGoBackButtonClicked" prefHeight="70.0" prefWidth="70.0"
                                    styleClass="action-btn" textOverrun="CLIP">
                                <padding>
                                    <Insets top="10.0"/>
                                </padding>
                                <graphic>
                                    <ImageView fitHeight="150.0" fitWidth="40.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <image>
                                            <Image url="@../../../../img/back.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </children>
                        <HBox.margin>
                            <Insets/>
                        </HBox.margin>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                    </Pane>
                </children>
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
            </HBox>

            <VBox alignment="CENTER" maxWidth="700.0" minWidth="700.0" prefWidth="700.0" styleClass="card">
                <Label styleClass="subtitle" text="Welcome dear subscriber, please login:"
                       wrapText="true"/>
                <HBox alignment="CENTER" spacing="30.0">
                    <Label fx:id="lblSubscriberId" alignment="CENTER_RIGHT" prefWidth="100.0" text="Subscriber ID:"
                           textAlignment="RIGHT"/>
                    <TextField fx:id="txtFieldSubscriberId" maxWidth="300.0" minWidth="300.0" prefWidth="300.0"
                               promptText="Enter your subscriber ID here"/>
                </HBox>
                <!-- Primary Action -->
                <Button fx:id="btnLogin" minHeight="50.0" onAction="#onLoginButtonClicked"
                        prefHeight="50.0"
                        prefWidth="300.0" text="Login">
                    <tooltip>
                        <Tooltip text="Review reservation schedules and table availability." wrapText="true"/>
                    </tooltip>
                    <styleClass>
                        <String fx:value="action-btn"/>
                        <String fx:value="outline"/>
                    </styleClass>
                    <graphic>
                        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../../img/newSub.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
