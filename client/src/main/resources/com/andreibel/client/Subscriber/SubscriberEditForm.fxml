<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Subscriber.SubscriberEditFormGUIController">
    <children>

        <Label fx:id="lblTitle" layoutX="22.0" layoutY="20.0" text="Edit your information:">
            <font>
                <Font size="21.0" />
            </font>
        </Label>

        <Label fx:id="lblEmail" layoutX="169.0" layoutY="151.0" text="Email:">
            <font>
                <Font size="17.0" />
            </font>
        </Label>

        <Label layoutX="103.0" layoutY="195.0" text="Phone Number:">
            <font>
                <Font size="17.0" />
            </font>
        </Label>

        <TextField fx:id="txtFieldEmail" layoutX="220.0" layoutY="149.0" prefHeight="26.0" prefWidth="192.0" />

        <TextField fx:id="txtFieldPhoneNumber" layoutX="220.0" layoutY="193.0" prefHeight="26.0" prefWidth="192.0" />

        <!-- Apply Changes button -->
        <Button fx:id="btnApplyChanges" layoutX="258.0" layoutY="270.0" mnemonicParsing="false" onAction="#onButtonApplyChangesClicked" prefHeight="43.0" prefWidth="116.0" style="-fx-background-color: #4CAF50;-fx-text-fill: white;-fx-font-weight: bold;-fx-font-size: 14px;" text="Apply Changes" />

        <!-- Go Back button -->
        <Button fx:id="btnGoBack" layoutX="14.0" layoutY="350.0" mnemonicParsing="false" onAction="#onBtnGoBackClicked" prefHeight="36.0" prefWidth="85.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px;" text="Go Back" />
      <Label fx:id="lblName" layoutX="167.0" layoutY="109.0" text="Name:">
         <font>
            <Font size="17.0" />
         </font>
      </Label>
      <TextField fx:id="txtFieldName" layoutX="220.0" layoutY="108.0" prefHeight="26.0" prefWidth="192.0" />

    </children>
</AnchorPane>
