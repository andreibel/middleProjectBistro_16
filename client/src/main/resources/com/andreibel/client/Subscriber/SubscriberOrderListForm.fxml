<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Subscriber.SubscriberOrderListFormGUIController">

    <children>

        <!-- Title -->
        <Label fx:id="lblSubscriber" layoutX="14.0" layoutY="14.0" prefWidth="570.0" text="Hi, SUBSCRIBER_NAME here is your orders history:" wrapText="true">
            <font>
                <Font size="19.0" />
            </font>
        </Label>

        <!-- Orders Table -->
        <TableView fx:id="tblViewOrderHistory" layoutX="14.0" layoutY="55.0" prefHeight="278.0" prefWidth="568.0" style="-fx-background-color: white; -fx-border-color: #d0c4b0;">

            <columns>
                <TableColumn fx:id="colRowNumber" prefWidth="75.0" text="#" />
                <TableColumn fx:id="colOrderDateTime" prefWidth="120.0" text="Order Date &amp; Time" />
                <TableColumn fx:id="colNumberOfPeople" prefWidth="118.0" text="# of People" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Go Back Button -->
        <Button fx:id="btnGoBack" layoutX="249.0" layoutY="350.0" mnemonicParsing="false" onAction="#onGoBackButtonClicked" prefHeight="36.0" prefWidth="99.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px;" text="Go Back" />

    </children>
</AnchorPane>
