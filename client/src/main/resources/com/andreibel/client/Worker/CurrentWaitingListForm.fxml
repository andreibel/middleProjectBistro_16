<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="413.0" prefWidth="600.0" style="-fx-background-color: #fff4e0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.CurrentWaitingFormGUIController">

    <children>

        <!-- Title -->
        <Label fx:id="lblTitle" layoutX="14.0" layoutY="14.0" style="-fx-text-fill: #1e293b;" text="Current Waiting List for: CURRENT_DATE">
            <font>
                <Font size="18.0" />
            </font>
        </Label>

        <!-- Table -->
        <TableView fx:id="tblViewCurrentWaiting" layoutX="14.0" layoutY="55.0" prefHeight="286.0" prefWidth="572.0" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #cbd5e1;">

            <columns>
                <TableColumn fx:id="colWaitingNumber" text="#" />
                <TableColumn fx:id="colOrderNumber" text="Order Number" />
                <TableColumn fx:id="colNumberOfGuests" text="# of Guests" />
                <TableColumn fx:id="colSubscriberID" text="Subscriber ID" />
                <TableColumn fx:id="colEmail" text="Email" />
                <TableColumn fx:id="colPhoneNumber" text="Phone Number" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Go Back Button -->
        <Button fx:id="btnGoBack" layoutX="14.0" layoutY="357.0" onAction="#onGoBackButtonClicked" prefHeight="42.0" prefWidth="100.0" style="-fx-background-color: #475569;                      -fx-text-fill: white;                      -fx-font-size: 14px;                      -fx-background-radius: 8;" text="Go Back" />
    </children>
</AnchorPane>
