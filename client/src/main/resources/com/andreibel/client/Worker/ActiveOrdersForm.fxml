<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="1060.0" stylesheets="@../../../../style/style.css"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.andreibel.client.Worker.ActiveOrdersFormGUIController">
    <VBox alignment="TOP_CENTER" spacing="60.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <HBox prefHeight="70.0" prefWidth="1556.0" spacing="20.0" style="-fx-min-width: 1040; -fx-max-width: 1040;">
            <VBox.margin>
                <Insets top="10.0"/>
            </VBox.margin>
            <HBox alignment="CENTER_RIGHT" fillHeight="false" maxWidth="1000.0" minHeight="-Infinity" minWidth="1000.0"
                  nodeOrientation="RIGHT_TO_LEFT" prefHeight="70.0" prefWidth="1000.0"
                  style="-fx-min-width: 940; -fx-pref-width: 940; -fx-max-width: 940;" styleClass="card">
                <Label fx:id="lblTitle" styleClass="title" text="Active Orders for CURRENT_DATE" wrapText="true"/>
                <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                    <viewport>
                        <Rectangle2D minX="1.0"/>
                    </viewport>
                    <Image url="@../../../../img/logo.png"/>
                </ImageView>
            </HBox>
            <Pane prefHeight="70.0" prefWidth="70.0" styleClass="card">
                <HBox.margin>
                    <Insets/>
                </HBox.margin>
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <Button fx:id="btnGoBack" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false"
                        onAction="#onGoBackButtonClicked" prefHeight="70.0" prefWidth="70.0" styleClass="action-btn"
                        textOverrun="CLIP">
                    <padding>
                        <Insets top="10.0"/>
                    </padding>
                    <graphic>
                        <ImageView fitHeight="150.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                            <Image url="@../../../../img/back.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </Pane>
        </HBox>
        <VBox alignment="CENTER" maxWidth="700.0" minWidth="1000.0" prefWidth="700.0" styleClass="card">
            <Label styleClass="subtitle" text="Current orders for today:" wrapText="true"/>
            <ScrollPane prefHeight="300.0" prefWidth="200.0">
                <TableView fx:id="tblActiveOrders" layoutX="20.0" layoutY="65.0" prefHeight="430.0" prefWidth="925.0">
                    <columns>
                        <TableColumn fx:id="colNumberOfGuests" prefWidth="120.0" text="Number Of Guests"/>
                        <TableColumn fx:id="colSubscriberId" prefWidth="242.0" text="Subscriber ID"/>
                        <TableColumn fx:id="colEmail" text="Email"/>
                        <TableColumn fx:id="colPhoneNumber" text="Phone Number"/>
                        <TableColumn fx:id="colOrderDateTime" text="Order Date Time"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </ScrollPane>
        </VBox>
    </VBox>
</AnchorPane>
