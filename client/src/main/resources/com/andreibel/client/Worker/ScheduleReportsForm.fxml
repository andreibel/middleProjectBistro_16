<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="1060.0" stylesheets="@../../../../style/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.ScheduleReportsFormGUIController">

    <styleClass>
        <String fx:value="root" />
    </styleClass>

    <children>

        <!-- Full page container -->
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <HBox prefHeight="70.0" prefWidth="1556.0" spacing="20.0" style="-fx-min-width: 1040; -fx-max-width: 1040;">
            <children>
                  <!-- Top bar (also uses .card, so must override width too) -->
                  <HBox alignment="CENTER_RIGHT" fillHeight="false" maxWidth="1000.0" minHeight="-Infinity" minWidth="1000.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="70.0" prefWidth="1000.0" style="-fx-min-width: 940; -fx-pref-width: 940; -fx-max-width: 940;" styleClass="card">
                      <children>
                           <Label fx:id="lblTitle" styleClass="title" text="Schedules Report: MONTH_NAME" wrapText="true" />
                          <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                  <Image url="@../../../../img/logo.png" />
                              </image>
                              <viewport>
                                  <Rectangle2D minX="1.0" />
                              </viewport>
                     </ImageView>
                      </children>
                  </HBox>
               <Pane prefHeight="70.0" prefWidth="70.0" styleClass="card">
                  <children>
      
                                      <!-- Back button moved here -->
                          <Button fx:id="btnGoBack" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#onGoBackButtonClicked" prefHeight="70.0" prefWidth="70.0" styleClass="action-btn" textOverrun="CLIP">
                        <padding>
                           <Insets top="10.0" />
                        </padding>
                        <graphic>
                           <ImageView fitHeight="150.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                              <image>
                                 <Image url="@../../../../img/back.png" />
                              </image></ImageView>
                        </graphic></Button>
                  </children>
                  <HBox.margin>
                     <Insets />
                  </HBox.margin>
                  <padding>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </padding>
               </Pane>
            </children>
            <VBox.margin>
               <Insets top="20.0" />
            </VBox.margin>
         </HBox>

            <!-- MAIN CARD (charts) -->
            <VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-min-width: 1040; -fx-pref-width: 1040; -fx-max-width: 1040;">
            <Pane prefHeight="340.0" prefWidth="200.0" styleClass="card">
               <children>
      
                      <!-- Line chart -->
                      <LineChart fx:id="lineChartArrivalsDepartures" prefHeight="240.0" prefWidth="1040.0" title="Customers Arrivals and Departures">
                          <xAxis>
                              <CategoryAxis fx:id="xAxis" />
                          </xAxis>
                          <yAxis>
                              <NumberAxis fx:id="yAxis" />
                          </yAxis>
                     <cursor>
                        <Cursor fx:constant="DEFAULT" />
                     </cursor>
                     <padding>
                        <Insets top="30.0" />
                     </padding>
                      </LineChart>
   
                       <!-- Right side controls -->
                       <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="toolbar">
                           <Label fx:id="lblTrack" styleClass="subtitle" text="Chose Day" />
                           <ComboBox fx:id="comboBoxTrack" onAction="#onComboBoxTrackValueSelected" prefHeight="36.0" prefWidth="140.0" styleClass="combo" />
                     <padding>
                        <Insets left="30.0" top="20.0" />
                     </padding>
                       </HBox>
               </children>
            </Pane>
            <Pane prefHeight="300.0" prefWidth="200.0" styleClass="card">
               <children>
      
                      <!-- Bar chart -->
                      <BarChart fx:id="barChartLatesDelays" prefHeight="200.0" prefWidth="1040.0" title="Customers Lates and Delays">
                          <xAxis>
                              <CategoryAxis fx:id="xDayAxis" />
                          </xAxis>
                          <yAxis>
                              <NumberAxis fx:id="yPeopleAxis" />
                          </yAxis>
                      </BarChart>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </Pane>

            </VBox>

        </VBox>

    </children>
</AnchorPane>
