<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.WorkerFormGUIController">

    <children>

        <!-- Title -->
        <Label fx:id="lblTitle" layoutX="14.0" layoutY="26.0" prefWidth="560.0" text="Hello STAFF_NAME, select an option below to proceed." wrapText="true">
            <font>
                <Font size="18.0" />
            </font>
        </Label>

        <!-- Register Subscriber -->
        <Button fx:id="btnRegister" layoutX="209.0" layoutY="103.0" onAction="#onRegisterButtonClicked" prefHeight="45.0" prefWidth="182.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;" text="Register New Subscriber">
            <tooltip>
                <Tooltip text="Register a new subscriber and provide them with exclusive benefits." wrapText="true" />
            </tooltip>
        </Button>

        <!-- Subscribers Report -->
        <Button fx:id="btnSubscribersReport" layoutX="209.0" layoutY="178.0" onAction="#onSubscribersReportButtonClicked" prefHeight="45.0" prefWidth="182.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px;" text="View Subscribers Report">
            <tooltip>
                <Tooltip text="View detailed information and statistics about subscribers." wrapText="true" />
            </tooltip>
        </Button>

        <!-- Schedules Report -->
        <Button fx:id="btnSchedulesReport" layoutX="209.0" layoutY="261.0" onAction="#onSchedulesReportButtonClicked" prefHeight="45.0" prefWidth="182.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px;" text="View Schedules Report">
            <tooltip>
                <Tooltip text="Review reservation schedules and table availability." wrapText="true" />
            </tooltip>
        </Button>

        <!-- Go Back -->
        <Button fx:id="btnGoBack" layoutX="14.0" layoutY="341.0" onAction="#onGoBackButtonClicked" prefHeight="45.0" prefWidth="103.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px;" text="Go Back" />

    </children>
</AnchorPane>
