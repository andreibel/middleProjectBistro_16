<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="447.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.CurrentDiningFormGUIController">
    <children>
        <!-- Title -->
        <Label fx:id="lblTitle" layoutX="20.0" layoutY="14.0" prefHeight="26.0" prefWidth="501.0" text="Current Dining at the Restaurant for CURRENT_DATE" textAlignment="CENTER" wrapText="true">
            <font>
                <Font size="20.0" />
            </font>
        </Label>

        <!-- TableView -->
        <TableView fx:id="tblViewCurrentDining" layoutX="14.0" layoutY="49.0" prefHeight="326.0" prefWidth="575.0" style="-fx-background-color: white; -fx-border-color: #cfd8dc; -fx-border-width: 1px;">
            <columns>
                <TableColumn fx:id="colOrderDate" prefWidth="100.0" text="Order Date" />
                <TableColumn fx:id="colOrderTime" prefWidth="100.0" text="Order Time" />
                <TableColumn fx:id="colNumberOfPeople" prefWidth="100.0" text="# of People" />
                <TableColumn fx:id="colTimeArrived" prefWidth="100.0" text="Time Arrived" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Go Back Button -->
        <Button fx:id="btnGoBack" layoutX="14.0" layoutY="398.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="106.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 14px;" text="Go Back" />
    </children>
</AnchorPane>
