<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<AnchorPane fx:id="rootPane" prefHeight="500.0" prefWidth="800.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.RegisteredSubscribersFormGUIController">

    <children>

        <!-- Title -->
        <Label fx:id="lblTitle" layoutX="20.0" layoutY="16.0" prefWidth="760.0" text="Registered Subscribers" wrapText="true">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <!-- Table -->
        <TableView fx:id="tblSubscribers" layoutX="20.0" layoutY="70.0" prefHeight="360.0" prefWidth="760.0" style="-fx-background-color: white; -fx-border-color: #d0c4b0;">

            <columns>
                <TableColumn fx:id="colSubscriberId" prefWidth="140.0" text="Subscriber ID" />
                <TableColumn fx:id="colName" prefWidth="180.0" text="Name" />
                <TableColumn fx:id="colEmail" prefWidth="240.0" text="Email" />
                <TableColumn fx:id="colPhone" prefWidth="180.0" text="Phone Number" />
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

        </TableView>

        <!-- Go Back -->
        <Button fx:id="btnGoBack" layoutX="20.0" layoutY="445.0" mnemonicParsing="false" onAction="#onGoBackButtonClicked" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px;" text="Go Back" />

    </children>
</AnchorPane>
