<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="570.0" prefWidth="601.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.ChangeBistroTimeFormGUIController"> <!-- soft warm background -->

   <children>
      <!-- Main Title -->
      <Label layoutX="14.0" layoutY="14.0" style="-fx-font-size: 21px; -fx-text-fill: #333;" text="Change Bistro Restaurant Settings:" />

      <!-- Edit regular times -->
      <Label fx:id="lblOpenClose" layoutX="68.0" layoutY="75.0" style="-fx-font-size: 16px; -fx-text-fill: #333;" text="Edit opening and closing time:" />

      <Label fx:id="lblOpen" layoutX="47.0" layoutY="140.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Opening Time:" />
      <TextField fx:id="txtFieldOpen" layoutX="146.0" layoutY="137.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Label fx:id="lblClose" layoutX="321.0" layoutY="140.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Closing Time:" />
      <TextField fx:id="txtFieldClose" layoutX="413.0" layoutY="137.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Button fx:id="btnUpdateRegular" layoutX="224.0" layoutY="240.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="154.0" style="-fx-background-color: #43A047; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 6px;" text="Update Regular Time" />

      <!-- Add special event -->
      <Label fx:id="lblEvent" layoutX="64.0" layoutY="310.0" style="-fx-font-size: 16px; -fx-text-fill: #333;" text="Add new special event:" />

      <Label fx:id="lblEventName" layoutX="53.0" layoutY="364.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Event's Name:" />
      <TextField fx:id="txtFieldEventName" layoutX="158.0" layoutY="361.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Label fx:id="lblEventDate" layoutX="326.0" layoutY="364.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Event's Date:" />
      <DatePicker fx:id="datePickerEvent" layoutX="422.0" layoutY="361.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 2px;" />

      <Label fx:id="lblEventOpen" layoutX="52.0" layoutY="419.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Opening Time:" />
      <TextField fx:id="txtFieldEventOpen" layoutX="158.0" layoutY="416.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Label fx:id="lblEventClose" layoutX="325.0" layoutY="419.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Closing Time:" />
      <TextField fx:id="txtFieldEventClose" layoutX="422.0" layoutY="416.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Button fx:id="btnCreateNewEvent" layoutX="228.0" layoutY="466.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="154.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 6px;" text="Create New Event" />

      <!-- Go Back Button -->
      <Button fx:id="btnGoBack" layoutX="15.0" layoutY="511.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="103.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6px;" text="Go Back" />
      <Label fx:id="lblInterval" layoutX="87.0" layoutY="192.0" text="Interval between orders:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <TextField fx:id="txtFieldInterval" layoutX="252.0" layoutY="190.0" prefHeight="25.0" prefWidth="160.0" />
      <Label fx:id="lblInfoRange" layoutX="88.0" layoutY="207.0" prefHeight="17.0" prefWidth="160.0" text="Range between: 15 to 60 minutes" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="11.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
