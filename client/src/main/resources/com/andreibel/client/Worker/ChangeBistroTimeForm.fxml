<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="rootPane" prefHeight="529.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.ChangeBistroTimeFormGUIController"> <!-- soft warm background -->

   <children>
      <!-- Main Title -->
      <Label layoutX="14.0" layoutY="14.0" style="-fx-font-size: 21px; -fx-text-fill: #333;" text="Change Bistro Restaurant Settings:" />

      <!-- Edit regular times -->
      <Label fx:id="lblOpenClose" layoutX="68.0" layoutY="75.0" style="-fx-font-size: 16px; -fx-text-fill: #333;" text="Edit opening and closing time:" />

      <Label fx:id="lblOpen" layoutX="47.0" layoutY="140.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Opening Time:" />
      <TextField fx:id="txtFieldOpen" layoutX="146.0" layoutY="137.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Label fx:id="lblClose" layoutX="321.0" layoutY="140.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Closing Time:" />
      <TextField fx:id="txtFieldClose" layoutX="413.0" layoutY="137.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Button fx:id="btnUpdateRegular" layoutX="230.0" layoutY="193.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="154.0" style="-fx-background-color: #43A047; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 6px;" text="Update Regular Time" />

      <!-- Add special event -->
      <Label fx:id="lblEvent" layoutX="66.0" layoutY="262.0" style="-fx-font-size: 16px; -fx-text-fill: #333;" text="Add new special event:" />

      <Label fx:id="lblEventName" layoutX="55.0" layoutY="316.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Event's Name:" />
      <TextField fx:id="txtFieldEventName" layoutX="160.0" layoutY="313.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Label fx:id="lblEventDate" layoutX="328.0" layoutY="316.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Event's Date:" />
      <DatePicker fx:id="datePickerEvent" layoutX="424.0" layoutY="313.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 2px;" />

      <Label fx:id="lblEventOpen" layoutX="54.0" layoutY="371.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Opening Time:" />
      <TextField fx:id="txtFieldEventOpen" layoutX="160.0" layoutY="368.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Label fx:id="lblEventClose" layoutX="327.0" layoutY="371.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Closing Time:" />
      <TextField fx:id="txtFieldEventClose" layoutX="424.0" layoutY="368.0" prefHeight="26.0" prefWidth="141.0" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <Button fx:id="btnCreateNewEvent" layoutX="230.0" layoutY="418.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="154.0" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 6px;" text="Create New Event" />

      <!-- Go Back Button -->
      <Button fx:id="btnGoBack" layoutX="15.0" layoutY="470.0" mnemonicParsing="false" prefHeight="45.0" prefWidth="103.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6px;" text="Go Back" />
   </children>
</AnchorPane>
