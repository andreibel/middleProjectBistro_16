<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="566.0" prefWidth="620.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Worker.EditRestaurantLayoutFormGUIController">
    <children>
        <Label fx:id="lblTitle" layoutX="208.0" layoutY="14.0" text="Edit Restaurant Layout">
            <font>
                <Font size="21.0" />
            </font>
        </Label>

        <TableView fx:id="tblViewRestaurantLayout" editable="true" layoutX="14.0" layoutY="50.0" prefHeight="392.0" prefWidth="586.0">
            <columns>
                <TableColumn fx:id="colCapacity" prefWidth="75.0" text="Capacity" />
                <TableColumn fx:id="colQuantity" prefWidth="75.0" text="Quantity" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Button fx:id="btnRemoveTable" layoutX="496.0" layoutY="443.0" mnemonicParsing="false" onAction="#onRemoveTableButtonClicked" style="-fx-background-color: #E53935; -fx-text-fill: white; -fx-font-size: 14px;" text="Remove Table">
            <tooltip>
                <Tooltip text="Remove the selected table from the layout." wrapText="true" />
            </tooltip>
        </Button>

        <Button fx:id="btnConfirmChanges" layoutX="246.0" layoutY="511.0" mnemonicParsing="false" onAction="#onConfirmChangesButtonClicked" prefHeight="41.0" prefWidth="123.0" style="-fx-background-color: #43A047; -fx-text-fill: white; -fx-font-size: 14px;" text="Confirm Changes">
            <tooltip>
                <Tooltip text="Save all changes made to the restaurant layout." wrapText="true" />
            </tooltip>
        </Button>

        <Button fx:id="btnGoBack" layoutX="14.0" layoutY="511.0" mnemonicParsing="false" onAction="#onGoBackButtonClicked" prefHeight="41.0" prefWidth="103.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px;" text="Go Back" />

        <Button fx:id="btnAddTable" layoutX="386.0" layoutY="443.0" mnemonicParsing="false" onAction="#onAddTableButtonClicked" prefHeight="27.0" prefWidth="103.0" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-size: 14px;" text="Add Table">
            <tooltip>
                <Tooltip text="Add a new table to the restaurant layout." wrapText="true" />
            </tooltip>
        </Button>
    </children>
</AnchorPane>
