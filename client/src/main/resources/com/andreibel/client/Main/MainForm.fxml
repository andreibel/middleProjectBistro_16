<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="rootPane" prefHeight="900.0" prefWidth="1600.0" stylesheets="@main-form.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Main.MainFormGUIController">

    <styleClass>
        <String fx:value="root" />
    </styleClass>

    <children>

        <!-- Full-page container -->
        <VBox alignment="TOP_CENTER" spacing="30.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Top bar (also uses .card, so must override width too) -->
            <HBox alignment="CENTER_RIGHT" minHeight="-Infinity" minWidth="-Infinity" nodeOrientation="RIGHT_TO_LEFT" prefHeight="70.0" style="-fx-min-width: 1500; -fx-pref-width: 1500; -fx-max-width: 1500;" styleClass="card">
                <VBox.margin>
                    <Insets top="20.0" />
                </VBox.margin>
            <children>
               <Label styleClass="title" text="Bistro" />
               <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../../../logo.png" />
                  </image>
                  <viewport>
                     <Rectangle2D minX="1.0" />
                  </viewport></ImageView>
            </children>
            </HBox>

            <!-- MAIN CARD -->
            <VBox alignment="TOP_CENTER" fillWidth="false" spacing="18" style="-fx-min-width: 1000; -fx-pref-width: 1000; -fx-max-width: 1000;" styleClass="card">

                <!-- Header -->
                <VBox alignment="CENTER" spacing="8">
                    <styleClass>
                        <String fx:value="header" />
                    </styleClass>

                    <Label fx:id="lblMainTitle" text="Welcome to Bistro Restaurant" textAlignment="CENTER" wrapText="true">
                        <styleClass>
                            <String fx:value="title" />
                        </styleClass>
                    </Label>

                    <Label text="Choose what you want to do" textAlignment="CENTER" wrapText="true">
                        <styleClass>
                            <String fx:value="subtitle" />
                        </styleClass>
                    </Label>
                </VBox>

                <!-- Actions -->
                <VBox alignment="CENTER" fillWidth="true" spacing="12">
                    <styleClass>
                        <String fx:value="actions" />
                    </styleClass>

                    <!-- Order Now -->
                    <Button fx:id="btnOrder" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#onOrderButtonClicked" prefHeight="56.0">
                        <styleClass>
                            <String fx:value="action-btn" />
                            <String fx:value="primary" />
                        </styleClass>

                        <tooltip>
                            <Tooltip text="Click to start a new order." wrapText="true" />
                        </tooltip>
                  <font>
                     <Font name="JetBrains Mono Regular" size="60.0" />
                  </font>
                        
                    </Button>

                    <!-- No Order -->
                    <Button fx:id="btnNoOrder" maxWidth="Infinity" mnemonicParsing="false" onAction="#onNoOrderButtonClicked" prefHeight="56.0" text="I don't have an order" wrapText="true">
                        <styleClass>
                            <String fx:value="action-btn" />
                            <String fx:value="outline" />
                        </styleClass>

                        <tooltip>
                            <Tooltip text="Enter the restaurant without a prior order and get seated." wrapText="true" />
                        </tooltip>
                    </Button>

                    <!-- Arrived -->
                    <Button fx:id="btnArrived" maxWidth="Infinity" mnemonicParsing="false" onAction="#onArrivedButtonClicked" prefHeight="56.0" text="I've arrived to my Order" wrapText="true">
                        <styleClass>
                            <String fx:value="action-btn" />
                            <String fx:value="outline" />
                        </styleClass>

                        <tooltip>
                            <Tooltip text="Mark yourself as present for this order." />
                        </tooltip>
                    </Button>

                    <!-- Cancel -->
                    <Button fx:id="btnCancel" maxWidth="Infinity" mnemonicParsing="false" onAction="#onCancelButtonClicked" prefHeight="56.0" text="Cancel My Order">
                        <styleClass>
                            <String fx:value="action-btn" />
                            <String fx:value="danger" />
                        </styleClass>

                        <tooltip>
                            <Tooltip text="Changed your mind? Cancel your order here." wrapText="true" />
                        </tooltip>
                    </Button>

                    <!-- Subscriber -->
                    <Button fx:id="btnSubscriber" maxWidth="Infinity" mnemonicParsing="false" onAction="#onSubscriberButtonClicked" prefHeight="56.0" text="Subscriber Login">
                        <styleClass>
                            <String fx:value="action-btn" />
                            <String fx:value="outline" />
                        </styleClass>

                        <tooltip>
                            <Tooltip text="Access the Subscriber Area to place orders with benefits and view your order history." wrapText="true" />
                        </tooltip>
                    </Button>
                </VBox>

                <!-- Footer row -->
                <HBox alignment="CENTER" spacing="12">
                    <styleClass>
                        <String fx:value="footer" />
                    </styleClass>

                    <Button fx:id="btnWorker" maxWidth="Infinity" mnemonicParsing="false" onAction="#onWorkerButtonClicked" prefHeight="48.0" text="I'm a Worker">
                        <styleClass>
                            <String fx:value="action-btn" />
                            <String fx:value="worker" />
                        </styleClass>

                        <graphic>
                            <Label text="badge">
                                <styleClass>
                                    <String fx:value="ms-icon" />
                                    <String fx:value="ms-worker" />
                                </styleClass>
                            </Label>
                        </graphic>

                        <tooltip>
                            <Tooltip text="Access the Worker Area (staff only)." wrapText="true" />
                        </tooltip>
                    </Button>
                </HBox>

                <!-- Hover info label -->
                <Label fx:id="lblHoverDetails" text="Hover on the buttons to see more details" textAlignment="CENTER" wrapText="true">
                    <styleClass>
                        <String fx:value="hint" />
                    </styleClass>
                </Label>

            </VBox>
        </VBox>
    </children>
</AnchorPane>
