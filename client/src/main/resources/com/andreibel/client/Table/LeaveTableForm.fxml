<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="284.0"
            prefWidth="560.0"
            style="-fx-background-color: #fff4e0;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.andreibel.client.Table.LeaveTableFormGUIController">

    <children>

        <!-- Title -->
        <Label fx:id="lblTitle"
               layoutX="45.0"
               layoutY="30.0"
               prefWidth="470.0"
               wrapText="true"
               text="Thank you for dining at Bistro Restaurant">
            <font>
                <Font size="26.0"/>
            </font>
        </Label>

        <!-- Pay Button -->
        <Button fx:id="btnPay"
                layoutX="219.0"
                layoutY="134.0"
                mnemonicParsing="false"
                prefHeight="42.0"
                prefWidth="140.0"
                text="Pay Your Order"
                style="-fx-background-color: #4CAF50;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;"/>

    </children>
</AnchorPane>
