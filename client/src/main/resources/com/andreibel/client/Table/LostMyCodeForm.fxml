<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="358.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Table.LostMyCodeFormGUIController">

    <children>

        <!-- Title -->
        <Label fx:id="lblTitle" layoutX="14.0" layoutY="21.0" prefHeight="50.0" prefWidth="560.0" text="If you lost your confirmation code, please enter either email or phone number, pick the order for the confirmation code  we'll send it to you:" wrapText="true">
            <font>
                <Font size="19.0" />
            </font>
        </Label>

        <!-- Retrieve Code -->
        <Button fx:id="btnRetrieveCode" layoutX="244.0" layoutY="247.0" mnemonicParsing="false" onAction="#onButtonRetrieveCodeClicked" prefHeight="44.0" prefWidth="135.0" style="-fx-background-color: #FF9800;                        -fx-text-fill: white;                        -fx-font-size: 14px;                        -fx-font-weight: bold;" text="Get Orders" />

        <!-- Go Back -->
        <Button fx:id="btnGoBack" layoutX="14.0" layoutY="300.0" mnemonicParsing="false" onAction="#onButtonGoBackClicked" prefHeight="44.0" prefWidth="115.0" style="-fx-background-color: #607D8B;                        -fx-text-fill: white;                        -fx-font-size: 13px;" text="Go Back" />
      <Label fx:id="lblEmail" layoutX="159.0" layoutY="112.0" text="Email:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label fx:id="lblPhoneNumber" layoutX="122.0" layoutY="155.0" text="Phone Number:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <TextField fx:id="txtFieldEmail" layoutX="244.0" layoutY="110.0" prefHeight="25.0" prefWidth="193.0" promptText="Enter your email here..." />
      <TextField fx:id="txtFieldPhoneNumber" layoutX="244.0" layoutY="153.0" prefHeight="25.0" prefWidth="193.0" promptText="Enter your phone number here..." />
      <ComboBox layoutX="244.0" layoutY="198.0" prefHeight="25.0" prefWidth="193.0" promptText="Select your order" />
      <Label fx:id="lblOrders" layoutX="135.0" layoutY="201.0" text="Select Order:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

    </children>
</AnchorPane>
