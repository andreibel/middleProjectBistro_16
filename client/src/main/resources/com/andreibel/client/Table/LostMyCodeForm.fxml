<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="358.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Table.LostMyCodeFormGUIController">

    <children>

        <!-- Title -->
        <Label fx:id="lblTitle" layoutX="14.0" layoutY="21.0" prefHeight="50.0" prefWidth="531.0" text="If you lost your confirmation code, please enter your order number and we'll send it to you:" wrapText="true">
            <font>
                <Font size="19.0" />
            </font>
        </Label>

        <!-- Order Number -->
        <Label fx:id="lblOrderNumber" layoutX="135.0" layoutY="133.0" text="Order Number:">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <TextField fx:id="txtFieldOrderNumber" layoutX="247.0" layoutY="130.0" prefHeight="28.0" prefWidth="193.0" promptText="Enter your order number here..." style="-fx-font-size: 13px;" />

        <!-- Retrieve Code -->
        <Button fx:id="btnRetrieveCode" layoutX="243.0" layoutY="192.0" mnemonicParsing="false" onAction="#onButtonRetrieveCodeClicked" prefHeight="44.0" prefWidth="135.0" style="-fx-background-color: #FF9800;                        -fx-text-fill: white;                        -fx-font-size: 14px;                        -fx-font-weight: bold;" text="Retrieve Code" />

        <!-- Go Back -->
        <Button fx:id="btnGoBack" layoutX="14.0" layoutY="300.0" mnemonicParsing="false" onAction="#onButtonGoBackClicked" prefHeight="44.0" prefWidth="115.0" style="-fx-background-color: #607D8B;                        -fx-text-fill: white;                        -fx-font-size: 13px;" text="Go Back" />

    </children>
</AnchorPane>
