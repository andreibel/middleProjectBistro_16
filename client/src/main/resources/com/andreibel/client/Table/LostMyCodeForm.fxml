<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="1060.0" stylesheets="@../../../../style/style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Table.LostMyCodeFormGUIController">

    <children>

        <!-- Full page container -->
        <VBox alignment="TOP_CENTER" spacing="40.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox prefHeight="70.0" prefWidth="1556.0" spacing="20.0" style="-fx-min-width: 1040; -fx-max-width: 1040;">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <!-- Top bar (also uses .card, so must override width too) -->
                <HBox alignment="CENTER_RIGHT" fillHeight="false" maxWidth="1000.0" minHeight="-Infinity" minWidth="1000.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="70.0" prefWidth="1000.0" style="-fx-min-width: 940; -fx-pref-width: 940; -fx-max-width: 940;" styleClass="card">
                    <Label fx:id="lblTitle" styleClass="title" text="Get Table" wrapText="true" />
                    <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../../../img/logo.png" />
                        </image>
                        <viewport>
                            <Rectangle2D minX="1.0" />
                        </viewport>
                    </ImageView>
                </HBox>
                <Pane prefHeight="70.0" prefWidth="70.0" styleClass="card">
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>

                    <!-- Back button moved here -->
                    <Button fx:id="btnGoBack" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#onButtonGoBackClicked" prefHeight="70.0" prefWidth="70.0" styleClass="action-btn" textOverrun="CLIP">
                        <padding>
                            <Insets top="10.0" />
                        </padding>
                        <graphic>
                            <ImageView fitHeight="150.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@../../../../img/back.png" />
                            </ImageView>
                        </graphic>
                    </Button>
                </Pane>
            </HBox>

            <VBox alignment="CENTER" maxWidth="700.0" minWidth="700.0" prefWidth="700.0" styleClass="card">
                <Label styleClass="subtitle" text="Enter you personal inforamtion" />
                <!-- Title -->
                <Label fx:id="dis" layoutX="14.0" layoutY="21.0" prefHeight="50.0" prefWidth="560.0" text="If you lost your confirmation code, please enter either email or phone number, pick the order for the confirmation code  we'll send it to you:" wrapText="true">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <HBox alignment="CENTER" spacing="30.0">
                    <Label fx:id="lblEmail" alignment="CENTER_RIGHT" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Email:" />
                    <TextField fx:id="txtFieldEmail" maxWidth="200.0" minWidth="200.0" prefWidth="200.0" promptText="Enter your email here..." />
                </HBox>
                <HBox alignment="CENTER" spacing="30.0">
                    <Label fx:id="lblPhoneNumber" alignment="CENTER_RIGHT" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Phone Number:" />
                    <TextField fx:id="txtFieldPhoneNumber" maxWidth="200.0" minWidth="200.0" prefWidth="200.0" promptText="Enter your phone number here..." />
                </HBox>
                <HBox alignment="CENTER" spacing="30.0">
                    <Label fx:id="lblOrders" alignment="CENTER_RIGHT" disable="true" layoutX="135.0" layoutY="201.0" maxWidth="100.0" minWidth="100.0" prefWidth="100.0" text="Select Order:" />
                    <ComboBox fx:id="comboBoxOrders" disable="true" maxWidth="200.0" minWidth="200.0" prefWidth="200.0" promptText="Select your order" />
                </HBox>


                <HBox alignment="CENTER" spacing="30.0">
                    <!-- Primary Action -->
                    <Button fx:id="btnRetrieveCode" minHeight="50.0" onAction="#onButtonRetrieveCodeClicked" prefHeight="50.0" prefWidth="250.0" text="Get Orders">
                        <tooltip>
                            <Tooltip text="Review reservation schedules and table availability." wrapText="true" />
                        </tooltip>
                        <styleClass>
                            <String fx:value="action-btn" />
                            <String fx:value="outline" />
                        </styleClass>
                        <graphic>
                            <ImageView fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                <Image url="@../../../../img/newWating.png" />
                            </ImageView>
                        </graphic>
                    </Button>

                </HBox>
                <Label fx:id="lblInfos" text="*Subscribers can retrieve orders without entering info, just click on Get Orders" />
            </VBox>

        </VBox>







    </children>
</AnchorPane>
