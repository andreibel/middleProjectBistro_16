<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<AnchorPane prefHeight="600.0" prefWidth="1060.0" stylesheets="@../../../../style/style.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.andreibel.client.Order.OrderFormGUIController">

    <children>

        <!-- Full page container -->
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox prefHeight="70.0" prefWidth="1556.0" spacing="20.0" style="-fx-min-width: 1040; -fx-max-width: 1040;">
                <children>
                    <!-- Top bar (also uses .card, so must override width too) -->
                    <HBox alignment="CENTER_RIGHT" fillHeight="false" maxWidth="1000.0" minHeight="-Infinity"
                          minWidth="1000.0" nodeOrientation="RIGHT_TO_LEFT" prefHeight="70.0" prefWidth="1000.0"
                          style="-fx-min-width: 940; -fx-pref-width: 940; -fx-max-width: 940;" styleClass="card">
                        <children>
                            <Label fx:id="lblTitle" styleClass="title" text="Place your order now!" wrapText="true"/>
                            <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../../img/logo.png"/>
                                </image>
                                <viewport>
                                    <Rectangle2D minX="1.0"/>
                                </viewport>
                            </ImageView>
                        </children>
                    </HBox>
                    <Pane prefHeight="70.0" prefWidth="70.0" styleClass="card">
                        <children>

                            <!-- Back button moved here -->
                            <Button fx:id="btnGoBack" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false"
                                    onAction="#onGoBackButtonClick" prefHeight="70.0" prefWidth="70.0"
                                    styleClass="action-btn" textOverrun="CLIP">
                                <padding>
                                    <Insets top="10.0"/>
                                </padding>
                                <graphic>
                                    <ImageView fitHeight="150.0" fitWidth="40.0" pickOnBounds="true"
                                               preserveRatio="true">
                                        <image>
                                            <Image url="@../../../../img/back.png"/>
                                        </image>
                                    </ImageView>
                                </graphic>
                            </Button>
                        </children>
                        <HBox.margin>
                            <Insets/>
                        </HBox.margin>
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                    </Pane>
                </children>
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
            </HBox>

            <VBox alignment="CENTER" maxWidth="700.0" minWidth="700.0" prefWidth="700.0" styleClass="card">
                <Label styleClass="subtitle" text="Create New Order:" wrapText="true"/>
                <ProgressBar fx:id="wizardProgrtes" prefWidth="500.0" progress="0.0"/>
                <VBox fx:id="DateNUmberVBOX" maxHeight="80.0" minHeight="80.0" prefHeight="80.0" prefWidth="100.0"
                      spacing="10.0">
                    <children>
                        <HBox fx:id="DateHbox" alignment="CENTER" spacing="30.0">
                            <!-- Date Label & Picker -->
                            <Label fx:id="lblDate" minWidth="120.0" text="Date of Order:"/>
                            <DatePicker fx:id="datePickerOrder" minWidth="300.0"
                                        promptText="Choose your preferred date"/>
                        </HBox>

                        <HBox fx:id="NumberOfPeopleHbox" alignment="CENTER" spacing="30.0">
                            <!-- Number of People -->
                            <Label fx:id="lblNumberOfPeople" minWidth="120.0" text="Number of People:"/>
                            <TextField fx:id="txtFieldNumberOfPeople" minWidth="300.0"
                                       promptText="# of people (including yourself)"/>
                        </HBox>
                    </children>
                </VBox>

                <HBox fx:id="TimeHbox" alignment="CENTER" minHeight="80.0" spacing="30.0">
                    <!-- Time Label & ComboBox -->
                    <Label fx:id="lblTime" minWidth="120.0" text="Time of Order:"/>
                    <ComboBox fx:id="comboBoxTime" minWidth="300.0" promptText="Select available times"/>
                </HBox>
                <VBox fx:id="EmailPhoneVBOX" alignment="CENTER" minHeight="80.0">
                    <HBox alignment="CENTER" spacing="30.0">
                        <Label fx:id="lblEmail" minWidth="120.0" text="Email:"/>
                        <TextField fx:id="txtFieldEmail" minWidth="300.0" promptText="Enter your email here"/>
                    </HBox>
                    <Label fx:id="lblOR" layoutX="339.0" layoutY="183.0" text="OR"/>

                    <HBox alignment="CENTER" spacing="30.0">
                        <Label fx:id="lblPhoneNumber" minWidth="120.0" text="Phone Number:"/>
                        <TextField fx:id="txtFieldPhoneNumber" minWidth="300.0"
                                   promptText="Enter your phone number here"/>
                    </HBox>
                </VBox>


                <HBox alignment="CENTER" spacing="30.0">
                    <!-- Primary Action -->
                    <Button fx:id="btnPrevious" minHeight="50.0" onAction="#onPreviousButtonClicked" prefHeight="50.0"
                            prefWidth="200.0" text="Previous">
                        <tooltip>
                            <Tooltip text="Review reservation schedules and table availability." wrapText="true"/>
                        </tooltip>
                        <styleClass>
                            <String fx:value="action-btn"/>
                            <String fx:value="outline"/>
                        </styleClass>
                        <graphic>
                            <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../../img/arrowBack.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                    <!-- Primary Action -->
                    <Button fx:id="btnOrderNow" minHeight="50.0" onAction="#onOrderNowButtonClicked" prefHeight="50.0"
                            prefWidth="200.0" text="Next">
                        <tooltip>
                            <Tooltip text="Review reservation schedules and table availability." wrapText="true"/>
                        </tooltip>
                        <styleClass>
                            <String fx:value="action-btn"/>
                            <String fx:value="danger"/>
                        </styleClass>
                        <graphic>
                            <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../../../img/arrowNext.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
