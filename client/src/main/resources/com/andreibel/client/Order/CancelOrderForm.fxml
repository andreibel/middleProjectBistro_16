<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="350.0" prefWidth="400.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Order.CancelOrderFormGUIController"> <!-- warm solid background -->

   <children>
      <!-- Title Label -->
      <Label fx:id="lblTitle" layoutX="30.0" layoutY="20.0" prefHeight="40.0" prefWidth="340.0" text="Please enter your Confirmation Code to Cancel:" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="17.0" />
         </font>
      </Label>

      <!-- Order Number Label -->
      <Label fx:id="lblConfrimationCode" layoutX="30.0" layoutY="104.0" text="Confirmation Code:">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

      <!-- Order Number TextField -->
      <TextField fx:id="txtFieldOrderNumber" layoutX="170.0" layoutY="100.0" prefHeight="28.0" prefWidth="180.0" promptText="Enter your confrimation code ..." />

      <!-- Cancel Order Button -->
      <Button fx:id="btnCancelOrder" layoutX="140.0" layoutY="150.0" mnemonicParsing="false" onAction="#onCancelOrderButtonClicked" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-size: 14px;" text="Cancel My Order">
      </Button>

      <!-- Go Back Button -->
      <Button fx:id="btnGoBack" layoutX="25.0" layoutY="280.0" mnemonicParsing="false" onAction="#onGoBackButtonClicked" prefHeight="28.0" prefWidth="100.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px;" text="Go Back">
      </Button>
   </children>
</AnchorPane>
