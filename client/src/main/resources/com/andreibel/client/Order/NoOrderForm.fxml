<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="344.0" prefWidth="600.0" style="-fx-background-color: #fff4e0;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.andreibel.client.Order.NoOrderFormGUIController"> <!-- soft warm background -->

   <children>
      <!-- Title Label -->
      <Label fx:id="lblTitle" layoutX="14.0" layoutY="14.0" text="Dining in without ordering">
         <font>
            <Font size="21.0" />
         </font>
      </Label>

      <!-- Guest Info Label -->
      <Label fx:id="lblGuest" layoutX="172.0" layoutY="60.0" prefHeight="20.0" prefWidth="293.0" style="-fx-font-size: 16px; -fx-text-fill: #333;" text="Guests may enter email or phone number" />

      <!-- Number of People -->
      <Label fx:id="lblNumberOfPeople" layoutX="126.0" layoutY="98.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Number of People:" />
      <TextField fx:id="txtFieldNumberOfPeople" layoutX="250.0" layoutY="95.0" prefHeight="26.0" prefWidth="224.0" promptText="Number of people (Including yourself)" style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <!-- Email -->
      <Label fx:id="lblEmail" layoutX="205.0" layoutY="151.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Email:" />
      <TextField fx:id="txtFieldEmail" layoutX="250.0" layoutY="148.0" prefHeight="26.0" prefWidth="224.0" promptText="Enter your email here..." style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <!-- OR Label -->
      <Label fx:id="lblOR" layoutX="353.0" layoutY="178.0" style="-fx-font-size: 17px; -fx-text-fill: #555;" text="OR" />

      <!-- Phone Number -->
      <Label fx:id="lblPhoneNumber" layoutX="145.0" layoutY="209.0" style="-fx-font-size: 15px; -fx-text-fill: #333;" text="Phone Number:" />
      <TextField fx:id="txtFieldPhoneNumber" layoutX="250.0" layoutY="206.0" prefHeight="26.0" prefWidth="224.0" promptText="Enter your phone number here..." style="-fx-background-color: white; -fx-border-color: #ccc; -fx-border-radius: 4px; -fx-padding: 4px;" />

      <!-- Submit Button -->
      <Button fx:id="btnSubmit" layoutX="318.0" layoutY="264.0" mnemonicParsing="false" onAction="#onSubmitButtonClicked" prefHeight="41.0" prefWidth="88.0" style="-fx-background-color: #43A047; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 6px;" text="Submit" />

      <!-- Go Back Button -->
      <Button fx:id="btnGoBack" layoutX="14.0" layoutY="289.0" mnemonicParsing="false" onAction="#onGoBackButtonClicked" prefHeight="41.0" prefWidth="88.0" style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6px;" text="Go Back" />
   </children>
</AnchorPane>
